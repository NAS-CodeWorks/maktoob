{
  "name": "maktoob-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "مكتوب — من السجلات إلى الديسكتوب. نظام العقود للمكاتب العراقية.",
  "author": "NAS CodeWorks",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build:electron && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "iq.nascodeworks.maktoob",
    "productName": "مكتوب",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "artifactName": "Maktoob-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
