{
  "name": "maktoob-desktop",
  "version": "1.1.1",
  "private": true,
  "description": "مكتوب — من السجلات إلى الديسكتوب. نظام العقود للمكاتب العراقية.",
  "author": "NAS CodeWorks",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "tsc -b && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run build:electron && node --test tests/*.test.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "license:keygen": "node scripts/generate-license-keys.mjs",
    "license:issue": "node scripts/issue-license.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "iq.nascodeworks.maktoob",
    "productName": "مكتوب",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "NAS-CodeWorks",
      "repo": "maktoob"
    },
    "artifactName": "Maktoob-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/license-public.pem",
        "to": "license-public.pem"
      },
      {
        "from": "resources/branding",
        "to": "branding"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/branding/maktoob.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/branding/maktoob.ico",
      "uninstallerIcon": "resources/branding/maktoob.ico",
      "uninstallDisplayName": "مكتوب",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "مكتوب"
    }
  }
}
